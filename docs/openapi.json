  "components": {
    "schemas": {
      "Action": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "cancel",
              "assign",
              "start",
              "finish",
              "accept",
              "reject",
              "comment",
              "classify"
            ],
            "title": "Action"
          },
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          },
          "note": {
            "type": "string",
            "maxLength": 2000,
            "title": "Note",
            "default": ""
          },
          "assignee_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Assignee Id"
          },
          "scheduled_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scheduled At"
          },
          "category": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "water",
                  "electric",
                  "door",
                  "furniture",
                  "other"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action",
          "version"
        ],
        "title": "Action"
      },
      "Body_upload_api_tickets__tid__attachments_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_api_tickets__tid__attachments_post"
      },
      "CreateTicket": {
        "properties": {
          "room_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Room Id"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 5,
            "title": "Description"
          },
          "category": {
            "type": "string",
            "enum": [
              "water",
              "electric",
              "door",
              "furniture",
              "other"
            ],
            "title": "Category",
            "default": "other"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "room_id",
          "description"
        ],
        "title": "CreateTicket"
      },
      "Credentials": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 40,
            "minLength": 3,
            "pattern": "^[\\w.-]+$",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 64,
            "minLength": 10,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Credentials"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Location": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 30,
            "minLength": 1,
            "title": "Name"
          },
          "building_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Building Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "Location"
      },
      "Password": {
        "properties": {
          "old_password": {
            "type": "string",
            "maxLength": 64,
            "title": "Old Password"
          },
          "new_password": {
            "type": "string",
            "maxLength": 64,
            "minLength": 10,
            "title": "New Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "old_password",
          "new_password"
        ],
